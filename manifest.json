{
  "manifest_version": 3,
  "name": "ココカラ！",
  "version": "0.1.0",
  "description": "ここから、少しスクロールしてここまで。範囲を指定してスクロールごとスクショ。",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "ココカラ！", "default_popup": "popup.html" },
  "icons": { "128": "icons/128.png" }
}
