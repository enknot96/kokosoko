{
  "manifest_version": 3,
  "name": "ココソコ - Koko Soko",
  "version": "1.0.0",
  "description": "ここからそこまで、範囲を指定してスクロールごとスクショ / Capture anything from here to there — select a range and shoot the whole scroll.",
  "homepage_url": "https://github.com/enknot96/kokosoko",
  "permissions": ["activeTab", "scripting"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "ココソコ - Koko Soko",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon/icon-16.png",
      "32": "icon/icon-32.png",
      "48": "icon/icon-48.png",
      "128": "icon/icon-128.png"
    }
  },
  "icons": {
    "16": "icon/icon-16.png",
    "32": "icon/icon-32.png",
    "48": "icon/icon-48.png",
    "128": "icon/icon-128.png"
  }
}
